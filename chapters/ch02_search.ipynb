    "## 2.6 Local Search Algorithms\n",
    "\n",
    "Local search operates on a **single current state** and moves to neighboring states. Useful when:\n",
    "- Path doesn't matter, only the solution\n",
    "- State space is too large for systematic search\n",
    "- Want to optimize objective function\n",
    "\n",
    "### 2.6.1 Hill Climbing\n",
    "\n",
    "Always move to the best neighboring state.\n",
    "\n",
    "**Problems:**\n",
    "- Gets stuck in local maxima\n",
    "- Plateaus (flat regions)\n",
    "- Ridges (require multiple steps)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class LocalSearchProblem:\n",
    "    \"\"\"Base class for local search problems\"\"\"\n",
    "    \n",
    "    def __init__(self, initial_state):\n",
    "        self.initial_state = initial_state\n",
    "    \n",
    "    def objective(self, state):\n",
    "        \"\"\"Objective function to MAXIMIZE\"\"\"\n",
    "        raise NotImplementedError\n",
    "    \n",
    "    def get_neighbors(self, state):\n",
    "        \"\"\"Return neighboring states\"\"\"\n",
    "        raise NotImplementedError\n",
    "\n",
    "def hill_climbing(problem, max_iterations=1000):\n",
    "    \"\"\"\n",
    "    Hill climbing: always move to best neighbor\n",
    "    Stops at local maximum\n",
    "    \"\"\"\n",
    "    current = problem.initial_state\n",
    "    current_value = problem.objective(current)\n",
    "    \n",
    "    for iteration in range(max_iterations):\n",
    "        neighbors = problem.get_neighbors(current)\n",
    "        \n",
    "        if not neighbors:\n",
    "            break\n",
    "        \n",
    "        # Find best neighbor\n",
    "        next_state = max(neighbors, key=problem.objective)\n",
    "        next_value = problem.objective(next_state)\n",
    "        \n",
    "        # Move only if better (strict improvement)\n",
    "        if next_value <= current_value:\n",
    "            print(f\"Hill climbing stopped at local maximum (iteration {iteration})\")\n",
    "            break\n",
    "        \n",
    "        current = next_state\n",
    "        current_value = next_value\n",
    "    \n",
    "    return current, current_value\n",
    "\n",
    "print(\"✓ Hill Climbing implemented!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2.6.2 Simulated Annealing\n",
    "\n",
    "Inspired by metallurgy - allows \"bad\" moves to escape local maxima.\n",
    "\n",
    "**Acceptance probability** for worse moves:\n",
    "\n",
    "$$P(\\text{accept}) = e^{\\frac{\\Delta E}{T}}$$\n",
    "\n",
    "where:\n",
    "- $\\Delta E$ = change in objective (negative for worse moves)\n",
    "- $T$ = temperature (decreases over time)\n",
    "\n",
    "**Cooling schedule**: $T_{t+1} = \\alpha \\cdot T_t$ where $0 < \\alpha < 1$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def simulated_annealing(problem, initial_temp=100, cooling_rate=0.95, \n",
    "                       max_iterations=1000, verbose=False):\n",
    "    \"\"\"\n",
    "    Simulated annealing with exponential cooling\n",
    "    Probabilistically accepts worse solutions\n",
    "    \"\"\"\n",
    "    current = problem.initial_state\n",
    "    current_value = problem.objective(current)\n",
    "    best = current\n",
    "    best_value = current_value\n",
    "    \n",
    "    temp = initial_temp\n",
    "    history = []\n",
    "    \n",
    "    for iteration in range(max_iterations):\n",
    "        if temp < 0.01:  # Temperature too low\n",
    "            break\n",
    "        \n",
    "        neighbors = problem.get_neighbors(current)\n",
    "        if not neighbors:\n",
    "            break\n",
    "        \n",
    "        # Random neighbor\n",
    "        next_state = random.choice(neighbors)\n",
    "        next_value = problem.objective(next_state)\n",
    "        \n",
    "        delta = next_value - current_value\n",
    "        \n",
    "        # Accept if better, or with probability based on temperature\n",
    "        if delta > 0 or random.random() < math.exp(delta / temp):\n",
    "            current = next_state\n",
    "            current_value = next_value\n",
    "            \n",
    "            if current_value > best_value:\n",
    "                best = current\n",
    "                best_value = current_value\n",
    "                if verbose:\n",
    "                    print(f\"New best: {best_value:.4f} at iteration {iteration}\")\n",
    "        \n",
    "        history.append(current_value)\n",
    "        temp *= cooling_rate  # Exponential cooling\n",
    "    \n",
    "    return best, best_value, history\n",
    "\n",
    "print(\"✓ Simulated Annealing implemented!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Example: N-Queens with Local Search\n",
    "\n",
    "Alternative approach: Start with all N queens on the board (possibly attacking) and minimize conflicts."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class NQueensLocal(LocalSearchProblem):\n",
    "    \"\"\"N-Queens for local search - minimize conflicts\"\"\"\n",
    "    \n",
    "    def __init__(self, n=8):\n",
    "        self.n = n\n",
    "        # Random initial state: one queen per column\n",
    "        initial = [random.randint(0, n-1) for _ in range(n)]\n",
    "        super().__init__(initial)\n",
    "    \n",
    "    def count_conflicts(self, board):\n",
    "        \"\"\"Count pairs of attacking queens\"\"\"\n",
    "        conflicts = 0\n",
    "        n = len(board)\n",
    "        for i in range(n):\n",
    "            for j in range(i + 1, n):\n",
    "                # Same row or diagonal\n",
    "                if board[i] == board[j] or abs(board[i] - board[j]) == j - i:\n",
    "                    conflicts += 1\n",
    "        return conflicts\n",
    "    \n",
    "    def objective(self, state):\n",
    "        \"\"\"Maximize negative conflicts (minimize conflicts)\"\"\"\n",
    "        return -self.count_conflicts(state)\n",
    "    \n",
    "    def get_neighbors(self, state):\n",
    "        \"\"\"Generate neighbors by moving one queen\"\"\"\n",
    "        neighbors = []\n",
    "        n = len(state)\n",
    "        for col in range(n):\n",
    "            for row in range(n):\n",
    "                if row != state[col]:\n",
    "                    neighbor = state[:]\n",
    "                    neighbor[col] = row\n",
    "                    neighbors.append(neighbor)\n",
    "        return neighbors\n",
    "\n",
    "# Solve 8-Queens with simulated annealing\n",
    "problem = NQueensLocal(8)\n",
    "print(f\"Initial conflicts: {problem.count_conflicts(problem.initial_state)}\\n\")\n",
    "\n",
    "solution, value, history = simulated_annealing(problem, initial_temp=10, \n",
    "                                                cooling_rate=0.99, verbose=True)\n",
    "\n",
    "conflicts = problem.count_conflicts(solution)\n",
    "print(f\"\\nFinal conflicts: {conflicts}\")\n",
    "if conflicts == 0:\n",
    "    print(\"✓ Found valid solution!\")\n",
    "    display_board(solution)"
   ]
  },
